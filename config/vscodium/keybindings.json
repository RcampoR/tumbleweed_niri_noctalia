// Place your key bindings in this file to override the defaults
[

  // Libera Ctrl+Shift+M del panel de Problems
  { "key": "ctrl+shift+m", "command": "-workbench.actions.view.problems" },

  // Inserta el pipe nativo |> solo en archivos R / Rmd / qmd
  {
    "key": "ctrl+shift+m",
    "command": "type",
    "args": { "text": " |> " },
    "when": "editorTextFocus && editorLangId =~ /r|rmd|qmd/"
  }

]