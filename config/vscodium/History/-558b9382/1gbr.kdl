// ==========================================
// REGLAS DE VENTANAS Y CAPAS
// ==========================================

// Work around WezTerm's initial configure bug
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Open the Firefox picture-in-picture player as floating by default
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block out two password managers from screen capture
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

// Bordes redondeados globales
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Reglas específicas por aplicación
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width {
        fixed 1080
    }
    default-window-height {
        fixed 920
    }
}


// ESPACIO #1 //

window-rule {
    match app-id="app.zen_browser.zen"

    open-on-workspace "1"
    open-maximized true

    opacity 0.88

    background-effect {
        blur true
    }
}

window-rule {
    match app-id="org.zotero.Zotero"
   open-on-workspace "1" 
   
   opacity 0.88

    background-effect {
        blur true
    }
}

// ESPACIO #2 //

window-rule {
    match app-id="codium"

    open-on-workspace "2"

    opacity 0.88

    background-effect {
        blur true
    }
}

window-rule {
    match app-id="ONLYOFFICE"

    open-on-workspace "2"
}


// ESPACIO #3 //

window-rule {
    match app-id="org.qgis.qgis"
    open-on-workspace "3"
}

window-rule {
    match app-id="org.kde.kdenlive"
    open-on-workspace "3"
}

window-rule {
    match app-id="gimp"
    open-on-workspace "3"
}

// ESPACIO #4 //

window-rule {
    match app-id="spotify"
    open-on-workspace "4"

    opacity 0.88

    background-effect {
        blur true
    }
}

window-rule {
    match app-id="com.valvesoftware.Steam"
    open-on-workspace "4"
}

window-rule {
    match app-id="com.heroicgameslauncher.hgl"
    open-on-workspace "4"
}

window-rule {
    match app-id="com.vysp3r.ProtonPlus"
    open-on-workspace "4"
}

window-rule {
    match app-id="com.dec05eba.gpu_screen_recorder"
    open-on-workspace "4"

    opacity 0.88

    background-effect {
        blur true
    }
}



// REGLAS ESPECIALES //

window-rule {
    match app-id="[Tt]hunar"
    opacity 0.88
    background-effect {
        blur true
    }
}


// BLUR GLOBAL - Efecto xray global para ventanas

window-rule {
    background-effect {
        blur true
        xray true
    }
}


// Regla de capas para componentes de Noctalia
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}