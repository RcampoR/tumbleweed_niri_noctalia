// ==========================================
// REGLAS DE VENTANAS
// ==========================================

// ── Bordes redondeados globales ──
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// ── Blur + xray global ──
window-rule {
    background-effect {
        blur true
        xray true
    }
}

// ── Noctalia: siempre flotante ──
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// ── WS1: Navegador (tu herramienta principal) ──
window-rule {
    match app-id="app.zen_browser.zen"
    open-on-workspace 1
    open-maximized true
    default-column-width { proportion 0.80; }
    opacity 0.88
    background-effect { blur true; }
}

// ── WS2: Escritura / Código / Referencias ──
window-rule {
    match app-id="codium"
    open-on-workspace 2
    default-column-width { proportion 0.60; }
    opacity 0.88
    background-effect { blur true; }
}

window-rule {
    match app-id="org.zotero.Zotero"
    open-on-workspace 2
    default-column-width { proportion 0.40; }
}

window-rule {
    match app-id="onlyoffice-desktopeditors"
    open-on-workspace 2
}

// ── WS3: GIS / Gráficos / Video ──
window-rule {
    match app-id="qgis"
    open-on-workspace 3
}

window-rule {
    match app-id="org.gimp.GIMP"
    open-on-workspace 3
}

window-rule {
    match app-id="org.kde.kdenlive"
    open-on-workspace 3
}

// ── Ubicuas (sin workspace fijo) ──
window-rule {
    match app-id="kitty"
    default-column-width { proportion 0.50; }
}

window-rule {
    match app-id="[Tt]hunar"
    default-column-width { proportion 0.40; }
    opacity 0.88
    background-effect { blur true; }
}

// ── Flotantes por naturaleza ──
window-rule {
    match app-id="pavucontrol"
    open-floating true
}

// ── Capas de Noctalia (barra, dock, OSD) ──
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect { xray false; }
}