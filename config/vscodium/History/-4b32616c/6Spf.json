{
    "twinny.embeddingIgnoredGlobs": [],
    "security.workspace.trust.untrustedFiles": "open"

"workbench.colorCustomizations": {
    // Fondo de la ventana con tu gris oscuro (mSurface: #242A30)
    "editor.background": "#242A30",
    "sideBar.background": "#242A30",
    "activityBar.background": "#242A30",
    "statusBar.background": "#242A30",
    "titleBar.activeBackground": "#242A30",
    "panel.background": "#242A30",
    "terminal.background": "#242A30",
    "menu.background": "#242A30",
    
    // Variantes de superficie (mSurfaceVariant: #2E353D)
    "input.background": "#2E353D",
    "dropdown.background": "#2E353D",
    "sideBarSectionHeader.background": "#2E353D",
    "editorWidget.background": "#2E353D",

    // Texto principal (mOnSurface: #D8DEE6)
    "foreground": "#D8DEE6",
    "editor.foreground": "#D8DEE6",
    "sideBar.foreground": "#D8DEE6",
    "statusBar.foreground": "#D8DEE6",
    
    // Texto secundario (mOnSurfaceVariant: #AEB7C2)
    "descriptionForeground": "#AEB7C2",
    "statusBar.debuggingForeground": "#AEB7C2",

    // Acentuado y Selección (mPrimary: #6E8FAF y mHover: #7696B4)
    "focusBorder": "#6E8FAF",
    "activityBar.activeBorder": "#6E8FAF",
    "activityBar.foreground": "#D8DEE6",
    "button.background": "#6E8FAF",
    "button.hoverBackground": "#7696B4",
    "button.foreground": "#F2F5F7",
    "selection.background": "#465362",
    
    // Bordes (mOutline: #56616D)
    "sideBar.border": "#56616D",
    "panel.border": "#56616D",
    "editorGroup.border": "#56616D"
  }


}