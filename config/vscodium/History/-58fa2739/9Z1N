# Pantalla completa
bindsym Print exec sh -c 'FILE="$HOME/Imágenes/Capturas/$(date +%F_%H-%M-%S).png"; grim "$FILE" && notify-send -i "$FILE" "📸 Captura guardada" "$(basename "$FILE")"'

# Selección de área
bindsym Shift+Print exec sh -c 'FILE="$HOME/Imágenes/Capturas/$(date +%F_%H-%M-%S).png"; grim -g "$(slurp)" "$FILE" && notify-send -i "$FILE" "📸 Captura guardada" "$(basename "$FILE")"'

# Pantalla completa al portapapeles
bindsym Ctrl+Print exec sh -c 'grim - | wl-copy && notify-send "📋 Captura copiada" "Pantalla completa copiada al portapapeles"'

# Área al portapapeles
bindsym Ctrl+Shift+Print exec sh -c 'grim -g "$(slurp)" - | wl-copy && notify-send "📋 Captura copiada" "Selección copiada al portapapeles"'

# Editar inmediatamente
bindsym Mod1+Print exec sh -c 'grim -g "$(slurp)" - | swappy -f -'



########## MENU ENERGIA ################

bindsym Ctrl+KP_Multiply exec pkill -x wlogout || wlogout

######## BLOQUEO PANTALLA #############

bindsym Ctrl+KP_Divide exec swaylock -f

