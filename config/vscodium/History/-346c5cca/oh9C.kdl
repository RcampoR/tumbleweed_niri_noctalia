// ==========================================
// CONFIGURACIÓN BASE DE NIRI
// ==========================================

// --- INCLUSIÓN DE ARCHIVOS EXTERNOS ---
include "reglas.kdl"
include "atajos.kdl"
include "noctalia.kdl"

// ESPACIOS DE TRABAJO PERSONALES

workspace 1

workspace 2

workspace 3

workspace 4

// Input device configuration.
input {
    keyboard {
        xkb {
            // If this section is empty, niri will fetch xkb settings
            // from org.freedesktop.locale1. You can control these using
            // localectl set-x11-keymap.
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        natural-scroll
    }

    trackpoint {
        // off
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 38
}

/-output "eDP-1" {
    mode "1920x1080@120.030"
    scale 2
    transform "normal"
    position x=1280 y=0
}

layout {
    gaps 16
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7696B4"
        inactive-color "#505050"
    }

    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 48
        spread -2
        offset x=0 y=8
        color "#00000022"
    }

    struts {
    }
}


// Autostart
spawn-at-startup "noctalia" 
spawn-at-startup "xsettingsd"

hotkey-overlay {
    // skip-at-startup
}

prefer-no-csd

screenshot-path "~/Imágenes/Capturas/Screenshot %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.90 stiffness=850 epsilon=0.0003
    }
    window-open {
        spring damping-ratio=0.78 stiffness=780 epsilon=0.0006
    }
    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.92 stiffness=700 epsilon=0.0003
    }
    window-movement {
        spring damping-ratio=0.80 stiffness=780 epsilon=0.0005
    }
    window-resize {
        spring damping-ratio=0.95 stiffness=820 epsilon=0.0003
    }
    overview-open-close {
        spring damping-ratio=0.90 stiffness=750 epsilon=0.0003
    }
    screenshot-ui-open {
        duration-ms 160
        curve "ease-out-quad"
    }
}

// Configuración global del efecto Blur
blur {
    passes 3
    offset 2.5
    noise 0.015
    saturation 0.92
}